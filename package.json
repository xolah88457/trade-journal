{
  "name": "trade-journal-monorepo",
  "version": "0.3.1",
  "private": true,
  "description": "The open-source trade journal. Broker sync, deep analytics, daily journaling, and AI-native reflection. Self-hosted, free forever.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xolah88457/trade-journal.git"
  },
  "author": "Sumi contributors <noreply@github.com>",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "preview": "pnpm build && pnpm start",
    "desktop:build": "node desktop/build.mjs",
    "desktop:open": "node desktop/open.mjs",
    "desktop:check": "node --test desktop/check.test.mjs",
    "desktop:package": "node desktop/package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron-builder": "26.18.0",
    "electron-sparkle": "0.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "autoInstallPeers": false,
    "peerDependencyRules": {
      "ignoreMissing": [
        "electron"
      ]
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
